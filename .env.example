# Copy to .env and fill in your own keys. Never commit .env.
# Groq (Whisper speech-to-text) - free key: https://console.groq.com/
GROQ_API_KEY=
# Google Gemini (guidance) - free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-flash-latest
# WHISPER_MODEL=whisper-large-v3-turbo
# CORS_ORIGINS=http://localhost:5173
# ADMIN_TOKEN=choose-a-password   # protects /#/admin dashboard
